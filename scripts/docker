#!/usr/bin/env python3
"""Transparent Docker CLI wrapper: time the official action's sole build, verify before scan."""
import datetime, json, os, pathlib, subprocess, sys, time
args=sys.argv[1:]
if args[:1] != ['build']:
    os.execv(os.environ['REAL_DOCKER'],[os.environ['REAL_DOCKER'],*args])
start=datetime.datetime.now(datetime.timezone.utc).isoformat()
t=time.monotonic()
rc=subprocess.call([os.environ['REAL_DOCKER'],*args])
pathlib.Path('results').mkdir(exist_ok=True)
pathlib.Path('results/build.json').write_text(json.dumps({'started_at':start,'completed_at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'seconds':time.monotonic()-t,'exit_code':rc},indent=2)+'\n')
if rc == 0:
    rc=subprocess.call(['bash','scripts/verify-image.sh','metlife-benchmark:latest'])
sys.exit(rc)
